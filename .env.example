# Copy to .env.local for local work. In Vercel, add the same names under Settings > Environment Variables.
# Never commit real values.

# Postgres connection string. In Neon, use the "pooled" connection string.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# A long random string that signs login cookies. Generate one with:  npx auth secret
AUTH_SECRET=

# From Google Cloud Console > APIs & Services > Credentials (see SETUP.md)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated emails that become hosts (admins) when they sign in. Put your own first.
ADMIN_EMAILS=you@example.com

# Local development only. Lets you sign in as seeded people without Google. Ignored in production builds.
# DEV_LOGIN=1
